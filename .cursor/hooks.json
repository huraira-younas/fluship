{
  "version": 1,
  "hooks": {
    "afterShellExecution": [
      {
        "command": ".cursor/hooks/fluship-board.sh after-shell",
        "matcher": "pipeline_progress\\.dart"
      }
    ],
    "postToolUse": [
      {
        "command": ".cursor/hooks/fluship-board.sh after-tool",
        "matcher": "Shell"
      }
    ],
    "afterAgentResponse": [
      {
        "command": ".cursor/hooks/fluship-board.sh after-response"
      }
    ],
    "stop": [
      {
        "command": ".cursor/hooks/fluship-board.sh stop",
        "loop_limit": 80
      }
    ]
  }
}
